# Copiá este archivo como .env.local y completá los valores de TU proyecto.
# .env.local nunca se sube al repositorio.

# Supabase · Project Settings → API
# La URL y la clave pública pueden llegar al navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: SÓLO para el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Fase 4). Se cargan en Vercel, no acá, cuando lleguemos.
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=
