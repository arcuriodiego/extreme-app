    "@supabase/supabase-js": "^2.50.0",
    "jsqr": "^1.4.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.0.0",
    "supabase": "^2.40.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
