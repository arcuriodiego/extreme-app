{
  "name": "extreme-app",
  "version": "0.1.0",
  "private": true,
  "description": "App de gestión y alumnos de Extreme Dance Academy",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:db": "bash scripts/test-db.sh",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
